# TestForge AI LLM configuration
# 五步启动：
# 1. git clone 项目并进入目录
# 2. python -m pip install -r requirements.txt
# 3. 复制本文件为 .env（Windows: Copy-Item .env.example .env）
# 4. 填写 LLM_API_KEY、LLM_BASE_URL、LLM_MODEL，并按需选择 LLM_PROVIDER
# 5. streamlit run app.py
#
# 只需修改 .env，不需要修改 Python 源代码。
# API Key 只保存在本机 .env 中；.env 已被 .gitignore 排除。
# 不要把真实 API Key 写入代码、SQLite 或提交到 GitHub。

# ===== 统一配置 / Unified settings =====
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120

# ===== 服务商示例 / Provider examples =====
# 1. DeepSeek
#   LLM_PROVIDER=deepseek
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#   API Key: https://platform.deepseek.com/api_keys
#
# 2. OpenAI
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   API Key: https://platform.openai.com/api-keys
#
# 3. 通义千问 / 阿里云百炼
#   LLM_PROVIDER=qwen
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#   API Key: https://bailian.console.aliyun.com/
#
# 4. Custom：自建网关、Ollama、vLLM 或其他 OpenAI 兼容服务
#   LLM_PROVIDER=custom
#   LLM_BASE_URL=http://localhost:8000/v1
#   LLM_MODEL=your-model-name
#   LLM_API_KEY=local  # 服务不校验 Key 时也必须填写一个非空值
#   Base URL 应指向 OpenAI 兼容根路径，不要再附加 /chat/completions。

# ===== 可选兼容性配置 / Compatibility =====
# auto 会按服务商和模型自动选择；服务端拒绝参数时 LLMClient 会移除或切换后重试。
# LLM_JSON_MODE=auto
# LLM_TOKEN_PARAMETER=auto
# LLM_REASONING_EFFORT=
# LLM_MAX_OUTPUT_TOKENS=32768
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_SECONDS=1.0
# LLM_MAX_VALIDATION_RETRIES=1
# LLM_MAX_TRUNCATION_RECOVERIES=2
#
# JSON Mode 可选 auto / true / false。Custom 默认不发送 JSON Mode，
# 确认服务支持后可设为 true；不支持时会回退为依赖 Prompt 返回 JSON。
# Token 参数可选 auto / max_tokens / max_completion_tokens。
# 思考参数留空表示不发送；可选 none/minimal/low/medium/high。

# ===== 旧版兼容 / Legacy compatibility =====
# 仅在 LLM_PROVIDER=deepseek 时回退读取以下旧变量；LLM_* 始终优先。
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=120

# ===== 可选：SQLite 数据库路径 / Optional database path =====
# 默认 data/testforge.db；相对路径基于项目根目录解析。
# TESTFORGE_DB_PATH=data/testforge.db
